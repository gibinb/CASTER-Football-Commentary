# CASTER — Environment Variables
# Copy this file to .env and fill in your values.
# None of these are required for the pipeline to run — each has a
# working fallback. They unlock progressively better quality.
#
#   cp .env.example .env
#   # edit .env with your values
#   # Then load before running: source .env  (or use python-dotenv)

# ---------------------------------------------------------------------------
# Phase 3 — Commentary Engine
# ---------------------------------------------------------------------------

# Groq API key (free tier: 14,400 requests/day, Llama 3.1 70B)
# Sign up at: https://console.groq.com — takes under 2 minutes
# Without this, commentary uses the rule-based template fallback (grounded
# but less fluent). The full pipeline works either way.
GROQ_API_KEY=

# Groq model to use (default: llama-3.1-8b-instant — fast and free)
# Upgrade to llama-3.1-70b-versatile for better quality (same free tier)
GROQ_MODEL=llama-3.1-8b-instant

# Path to a local GGUF model file for fully offline inference via llama.cpp.
# Leave blank to use Groq or template fallback.
# Example: /home/user/models/llama-3.2-3b-caster-dramatic-q4_k_m.gguf
LOCAL_GGUF_PATH=

# ---------------------------------------------------------------------------
# Phase 4 — Integration and Polish
# ---------------------------------------------------------------------------

# FastAPI backend port (default: 8000)
PHASE4_PORT=8000

# React / Vite dev server port (default: 5173)
# Only change this if 5173 is in use; also update vite.config.js proxy target
PHASE4_FRONTEND_PORT=5173

# ---------------------------------------------------------------------------
# Optional: Redis (Phase 3 backend/redis_queue.py)
# Only needed if you run the Phase 3 standalone backend (phase3/backend/main.py)
# in addition to the Phase 4 integrated server. Phase 4 does not use Redis
# directly — it runs the CV and LLM workers in the same async process.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
