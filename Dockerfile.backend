# CASTER — Backend Dockerfile
# Builds the Phase 4 FastAPI server with all Phase 1-3 dependencies.
#
# Note: YOLO detection requires ultralytics + opencv which are heavy.
# If you only want commentary (no live CV), the image still works —
# pipeline_runner.py falls back to offline Phase 2 JSON replay when
# YOLO weights are absent.

FROM python:3.11-slim

WORKDIR /app

# Install system deps needed by OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy all source (phases 1-4 + shared root files)
COPY . .

# Create directories that must exist at runtime
RUN mkdir -p data/raw data/labels outputs phase1/weights phase2/saved_models

EXPOSE 8000

CMD ["python", "phase4/run_phase4.py", "--host", "0.0.0.0", "--port", "8000"]
